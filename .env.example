# Maminco mobile - environment variables
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
#
# API base URL of the NestJS backend (no trailing slash, no `/api` suffix).
# - iOS simulator / web: http://localhost:3000
# - Android emulator:    http://10.0.2.2:3000
# - Physical device:     http://<your-lan-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# socket.io server URL (defaults to EXPO_PUBLIC_API_URL when omitted).
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
